public_url = ${jsonencode(public_url)}
database_url = ${jsonencode(database_url)}
valkey_url = ${jsonencode(valkey_url)}
nats_url = ${jsonencode(nats_url)}

[nats_user]
user = "aspen"
password = ${jsonencode(nats_password)}

[nats]
monitor_url = ${jsonencode(nats_monitor_url)}

[rate_limits]
trusted_proxies = ${jsonencode(trusted_proxies)}

[media.s3]
endpoint = ${jsonencode(s3_endpoint)}
public_base_url = ${jsonencode(media_url)}
bucket = ${jsonencode(bucket)}
region = ${jsonencode(region)}
access_key = ${jsonencode(s3_access_key)}
secret_key = ${jsonencode(s3_secret_key)}
%{ if email != null ~}

[email]
smtp_url = ${jsonencode(email.smtp_url)}
from = ${jsonencode(email.from)}
%{ endif ~}
