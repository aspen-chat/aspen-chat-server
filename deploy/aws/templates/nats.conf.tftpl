listen: "${listen_address}:4222"
http: "${listen_address}:8222"

jetstream {
  store_dir: "/tmp/jetstream"
  max_memory_store: ${max_memory_store_bytes}
  max_file_store: 1GB
}

authorization {
  users = [
    { user: "aspen", password: "${server_password}" }
%{ for name, voice in voice_servers ~}
    { user: "${name}", password: "${voice.password}", permissions: {
        publish: { allow: [
          "aspen.voice.report.*.${voice.id}",
          "aspen.voice.speaking.*.${voice.id}",
          "aspen.voice.token-key",
          "$JS.API.INFO",
          "$JS.API.STREAM.INFO.KV_aspen_rate_limits",
          "$JS.API.CONSUMER.CREATE.KV_aspen_rate_limits",
          "$JS.API.CONSUMER.CREATE.KV_aspen_rate_limits.>",
          "$JS.API.CONSUMER.DELETE.KV_aspen_rate_limits.>",
          "$JS.API.DIRECT.GET.KV_aspen_rate_limits.>",
          "$JS.API.STREAM.MSG.GET.KV_aspen_rate_limits",
          "$JS.FC.KV_aspen_rate_limits.>"
        ] }
        subscribe: { allow: [
          "aspen.voice.command.${voice.id}",
          "_INBOX_voice.${voice.id}.>"
        ] }
    } }
%{ endfor ~}
  ]
}
