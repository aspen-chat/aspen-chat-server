id = ${jsonencode(id)}
nats_url = ${jsonencode(nats_url)}
listen_addr = "0.0.0.0:9000"

[nats_user]
user = ${jsonencode(name)}
password = ${jsonencode(nats_password)}

[rate_limits]
trusted_proxies = ${jsonencode(trusted_proxies)}

[rtc]
announced_address = [${jsonencode(public_address)}]
min_port = ${min_port}
max_port = ${max_port}
