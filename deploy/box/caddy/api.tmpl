${domain} {
	# Whichever API server is running, and both for the moment an upgrade has two: a request
	# that finds one gone is given to the other.
	reverse_proxy 127.0.0.1:8080 127.0.0.1:8081 {
		# Whether the server is running, not whether its database is: a server that cannot
		# reach its database still tells people what is wrong, which a proxy with no server to
		# send them to cannot.
		health_uri /api/v1/health
		health_interval 2s
		health_timeout 2s
		lb_policy first
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# The same name over plain HTTP, which Caddy sends on to HTTPS for every name it serves. The
# API's requests are refused instead: a client set up with an `http://` address would follow
# the redirect and go on working, sending its token in the clear ahead of every one, where a
# refusal fails the first time it is tried.
http://${domain} {
	handle /api/* {
		respond "This deployment answers its API over HTTPS only: use https://${domain}. Whatever was sent with this request, a session or bot token included, crossed the network unencrypted, so replace it." 403
	}
	handle {
		redir https://${domain}{uri} permanent
	}
}
