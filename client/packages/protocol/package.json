{
  "name": "@aspen/protocol",
  "private": true,
  "version": "0.1.0",
  "description": "Typed access to the Aspen server: code generated from openapi.yaml and event_schema.json plus the HTTP session and WebSocket event-stream clients built on it.",
  "license": "MPL-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "codegen": "tsx scripts/codegen.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "mediasoup-client": "^3.24.5",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "json-schema-to-typescript": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
