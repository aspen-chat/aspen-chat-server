{
  "name": "@aspen/protocol",
  "private": true,
  "version": "0.1.0",
  "description": "Typed access to the Aspen server: code generated from openapi.yaml and event_schema.json plus the HTTP session and WebSocket event-stream clients built on it.",
  "license": "MPL-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./device": "./src/device.ts"
  },
  "scripts": {
    "codegen": "tsx scripts/codegen.ts",
    "build": "node node_modules/typescript-7/bin/tsc --noEmit",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "test": "vitest run",
    "build:calls": "vite build calls",
    "calls": "tsx calls/drive.ts",
    "calls:second": "tsx calls/second.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "json-schema-to-typescript": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@~7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
