<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No backups: the app's storage holds sessions and push keys (res/xml/data_extraction_rules.xml). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- A call's picture may go on in the system's picture-in-picture window as the user leaves
             (call/AspenCallPlugin.kt); the configuration changes named keep the activity, and so
             the call's page, through the shrink and the turn. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The system browser returns here after a passkey ceremony (aspen://auth/passkey). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aspen" />
            </intent-filter>

        </activity>

        <!-- Every FCM message comes here, and the push plugin's own service is removed: this one
             shows the relay's pushes (spec/push.md) and hands the rest to the plugin. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".push.AspenMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Sends attachments once the app has left the screen (uploads/UploadService.java). -->
        <service
            android:name=".uploads.UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Has Google Play services install its photo picker on Android releases older than
             the system's own (media/AspenMediaPlugin.java). -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES" />
            </intent-filter>
            <meta-data android:name="photopicker_activity:0:required" android:value="" />
        </service>
        <!-- Keeps the process alive for the length of a call the call engine holds, with the
             ongoing call's notification (call/CallService.kt), of the camera's kind too while the
             call's camera is on. A build without the call layer
             (client/docs/architecture/android-builds.md) has no such class and never starts it. -->
        <service
            android:name=".call.CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- The camera apps a message's photo or video is taken with (media/AspenMediaPlugin.java),
         which Android otherwise hides from the app. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Calls: the WebView's getUserMedia asks for both before it hands the page a microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Cameras in calls, asked for the same way; a phone without one still installs the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Uploads that go on in the background: the service that keeps the process alive, of the
         kind the system requires it to name from Android 14, and the processor kept awake. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The call engine's calls are the app's own calls in Telecom (call/CallTelecom.kt), and
         the service that keeps the process alive for one is of the two kinds a call is
         (call/CallService.kt). -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- A DM call ringing the phone shows its call notification over the lock screen
         (call/CallService.kt, the incoming call's full-screen intent). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
</manifest>
