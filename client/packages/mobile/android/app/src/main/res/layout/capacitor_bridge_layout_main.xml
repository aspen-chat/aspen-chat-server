<?xml version="1.0" encoding="utf-8"?>
<!-- Capacitor's own layout of the same name, with the app's web view (AspenWebView) in place of
     its CapacitorWebView; the app's resource is the one the bridge inflates, which lint, reading
     the app alone, takes for unused. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.getcapacitor.BridgeActivity"
    tools:ignore="UnusedResources"
    >

    <com.aspen_chat.client.input.AspenWebView
        android:id="@+id/webview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
