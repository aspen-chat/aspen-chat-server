{
  "name": "@aspen/mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Capacitor shell for Android and iOS. Wraps the @aspen/app build; both native projects are kept here.",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @aspen/app build:shell",
    "typecheck": "tsc --noEmit",
    "test": "echo \"@aspen/mobile: run test:android with an Android SDK\"",
    "test:android": "cd android && ./gradlew :app:testDebugUnitTest :app:connectedDebugAndroidTest",
    "sync": "pnpm build && cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "pnpm sync && cap run android",
    "run:ios": "pnpm sync && cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/screen-orientation": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^26.4.1",
    "typescript": "~5.9.3"
  }
}
