{
  "name": "aspen-client",
  "private": true,
  "version": "0.1.0",
  "description": "Aspen chat client: one TypeScript web app shipped to browsers, Electron, and Capacitor.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "pnpm --filter @aspen/protocol codegen",
    "codegen": "pnpm --filter @aspen/protocol codegen",
    "codegen:regen": "pnpm --filter @aspen/protocol codegen -- --regen",
    "dev": "pnpm --filter @aspen/app dev",
    "dev:desktop": "pnpm --filter @aspen/desktop dev",
    "build": "pnpm codegen && pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm codegen && pnpm -r --filter './packages/*' typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter './packages/*' test",
    "e2e": "pnpm --filter @aspen/app e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
